{
  "version": "1.0.0",
  "description": "NapkinCloud canonical AWS service registry — SINGLE SOURCE OF TRUTH for supported service types, roles, edge semantics, and SAM wiring metadata. Consumed by the frontend (src/lib/serviceRegistry.ts) and the backend compiler (backend/src/compiler/*) through shared/graphRules.js. Do not duplicate this data anywhere else.",
  "edgeKinds": [
    "invokes",
    "triggers",
    "writes",
    "reads",
    "publishes",
    "fails-to",
    "monitors",
    "starts",
    "flow"
  ],
  "defaultEdgeKindByPair": {
    "api_gateway>lambda": "invokes",
    "s3>lambda": "triggers",
    "sqs>lambda": "triggers",
    "sns>lambda": "triggers",
    "eventbridge>lambda": "triggers",
    "kinesis>lambda": "triggers",
    "step_functions>lambda": "triggers",
    "cognito>lambda": "triggers",
    "cloudwatch>lambda": "monitors",
    "lambda>dynamodb": "writes",
    "lambda>s3": "writes",
    "lambda>sqs": "writes",
    "lambda>kinesis": "writes",
    "lambda>sns": "publishes",
    "lambda>eventbridge": "publishes",
    "lambda>secrets_manager": "reads",
    "lambda>step_functions": "starts",
    "lambda>cloudwatch": "monitors"
  },
  "roleBuckets": [
    "entries",
    "compute",
    "stores",
    "queues",
    "topics",
    "buses",
    "streams",
    "monitors",
    "auth",
    "secrets",
    "workflows"
  ],
  "services": {
    "api_gateway": {
      "type": "api_gateway",
      "label": "API Gateway",
      "subLabel": "HTTPS Entry Point",
      "role": "entry",
      "roleBucket": "entries",
      "nodeComponent": "api_gateway",
      "color": "#06b6d4",
      "canTriggerLambda": true,
      "requiresIncoming": false,
      "defaults": { "method": "POST", "path": "/items" },
      "outputKeys": ["ApiUrl"],
      "samKind": "AWS::Serverless::Api"
    },
    "lambda": {
      "type": "lambda",
      "label": "AWS Lambda",
      "subLabel": "Serverless Compute",
      "role": "compute",
      "roleBucket": "compute",
      "nodeComponent": "lambda",
      "color": "#f59e0b",
      "canTriggerLambda": false,
      "requiresIncoming": true,
      "defaults": { "functionName": "ProcessFunction", "runtime": "nodejs20.x" },
      "outputKeys": ["LambdaFunctionName"],
      "samKind": "AWS::Serverless::Function"
    },
    "dynamodb": {
      "type": "dynamodb",
      "label": "DynamoDB",
      "subLabel": "NoSQL Table",
      "role": "store",
      "roleBucket": "stores",
      "nodeComponent": "dynamodb",
      "color": "#6366f1",
      "canTriggerLambda": false,
      "requiresIncoming": true,
      "defaults": { "tableName": "DataTable", "primaryKey": "id" },
      "outputKeys": ["TableName", "OrdersTableName"],
      "samKind": "AWS::DynamoDB::Table",
      "lambdaEnvVar": "TABLE_NAME",
      "lambdaPolicy": { "template": "DynamoDBCrudPolicy", "argName": "TableName", "argSource": "Ref" }
    },
    "s3": {
      "type": "s3",
      "label": "AWS S3 Bucket",
      "subLabel": "Object Storage",
      "role": "store",
      "roleBucket": "stores",
      "nodeComponent": "s3",
      "color": "#10b981",
      "canTriggerLambda": true,
      "requiresIncoming": false,
      "defaults": { "resourceName": "app-bucket" },
      "outputKeys": ["BucketName"],
      "samKind": "AWS::S3::Bucket",
      "lambdaEnvVar": "BUCKET_NAME",
      "lambdaPolicy": { "template": "S3CrudPolicy", "argName": "BucketName", "argSource": "Ref" },
      "lambdaEvent": {
        "Type": "S3",
        "Properties": { "Bucket": { "Ref": "$ID" }, "Events": "s3:ObjectCreated:*" }
      }
    },
    "sqs": {
      "type": "sqs",
      "label": "AWS SQS Queue",
      "subLabel": "Message Queue",
      "role": "queue",
      "roleBucket": "queues",
      "nodeComponent": "sqs",
      "color": "#ec4899",
      "canTriggerLambda": true,
      "requiresIncoming": false,
      "defaults": { "resourceName": "app-queue" },
      "outputKeys": ["QueueUrl"],
      "samKind": "AWS::SQS::Queue",
      "lambdaEnvVar": "QUEUE_URL",
      "lambdaPolicy": { "template": "SQSSendMessagePolicy", "argName": "QueueName", "argSource": "GetAtt:QueueName" },
      "lambdaEvent": {
        "Type": "SQS",
        "Properties": { "Queue": { "Fn::GetAtt": ["$ID", "Arn"] }, "BatchSize": 10 }
      }
    },
    "sns": {
      "type": "sns",
      "label": "AWS SNS Topic",
      "subLabel": "Pub/Sub Topic",
      "role": "topic",
      "roleBucket": "topics",
      "nodeComponent": "sns",
      "color": "#f43f5e",
      "canTriggerLambda": true,
      "requiresIncoming": false,
      "defaults": { "resourceName": "app-topic" },
      "outputKeys": ["TopicArn"],
      "samKind": "AWS::SNS::Topic",
      "lambdaEnvVar": "TOPIC_ARN",
      "lambdaPolicy": { "template": "SNSPublishMessagePolicy", "argName": "TopicName", "argSource": "GetAtt:TopicName" },
      "lambdaEvent": { "Type": "SNS", "Properties": { "Topic": { "Ref": "$ID" } } }
    },
    "eventbridge": {
      "type": "eventbridge",
      "label": "EventBridge Bus",
      "subLabel": "Event Bus",
      "role": "bus",
      "roleBucket": "buses",
      "nodeComponent": "eventbridge",
      "color": "#a855f7",
      "canTriggerLambda": true,
      "requiresIncoming": false,
      "defaults": { "resourceName": "app-eventbus" },
      "outputKeys": ["EventBusName"],
      "samKind": "AWS::Events::EventBus",
      "lambdaEnvVar": "EVENT_BUS_NAME",
      "lambdaPolicy": { "template": "EventBridgePutEventsPolicy", "argName": "EventBusName", "argSource": "Ref" },
      "lambdaEvent": {
        "Type": "EventBridgeRule",
        "Properties": { "EventBusName": { "Ref": "$ID" }, "Pattern": {} }
      }
    },
    "cognito": {
      "type": "cognito",
      "label": "Cognito User Pool",
      "subLabel": "User Auth",
      "role": "auth",
      "roleBucket": "auth",
      "nodeComponent": "cognito",
      "color": "#8b5cf6",
      "canTriggerLambda": true,
      "requiresIncoming": false,
      "defaults": { "resourceName": "app-userpool" },
      "outputKeys": ["UserPoolId"],
      "samKind": "AWS::Cognito::UserPool",
      "lambdaEnvVar": "USER_POOL_ID"
    },
    "cloudwatch": {
      "type": "cloudwatch",
      "label": "CloudWatch Alarms",
      "subLabel": "Monitoring",
      "role": "monitor",
      "roleBucket": "monitors",
      "nodeComponent": "cloudwatch",
      "color": "#f97316",
      "canTriggerLambda": false,
      "requiresIncoming": false,
      "defaults": { "resourceName": "app-alarm" },
      "outputKeys": ["AlarmName"],
      "samKind": "AWS::CloudWatch::Alarm"
    },
    "kinesis": {
      "type": "kinesis",
      "label": "Kinesis Stream",
      "subLabel": "Data Stream",
      "role": "stream",
      "roleBucket": "streams",
      "nodeComponent": "kinesis",
      "color": "#38bdf8",
      "canTriggerLambda": true,
      "requiresIncoming": false,
      "defaults": { "resourceName": "app-stream" },
      "outputKeys": ["StreamName"],
      "samKind": "AWS::Kinesis::Stream",
      "lambdaEnvVar": "STREAM_NAME",
      "lambdaPolicy": { "template": "KinesisCrudPolicy", "argName": "StreamName", "argSource": "Ref" },
      "lambdaEvent": {
        "Type": "Kinesis",
        "Properties": {
          "Stream": { "Fn::GetAtt": ["$ID", "Arn"] },
          "StartingPosition": "LATEST",
          "BatchSize": 100
        }
      }
    },
    "step_functions": {
      "type": "step_functions",
      "label": "Step Functions",
      "subLabel": "Workflow",
      "role": "workflow",
      "roleBucket": "workflows",
      "nodeComponent": "step_functions",
      "color": "#d946ef",
      "canTriggerLambda": true,
      "requiresIncoming": false,
      "defaults": { "resourceName": "app-statemachine" },
      "outputKeys": ["StateMachineArn"],
      "samKind": "AWS::Serverless::StateMachine",
      "lambdaEnvVar": "STATE_MACHINE_ARN",
      "lambdaPolicy": { "template": "StepFunctionsExecutionPolicy", "argName": "StateMachineName", "argSource": "GetAtt:Name" }
    },
    "secrets_manager": {
      "type": "secrets_manager",
      "label": "Secrets Manager",
      "subLabel": "Secrets",
      "role": "secret",
      "roleBucket": "secrets",
      "nodeComponent": "secrets_manager",
      "color": "#14b8a6",
      "canTriggerLambda": false,
      "requiresIncoming": false,
      "defaults": { "resourceName": "app-secret" },
      "outputKeys": ["SecretArn"],
      "samKind": "AWS::SecretsManager::Secret",
      "lambdaEnvVar": "SECRET_ARN",
      "lambdaPolicy": { "template": "SecretsManagerReadWritePolicy", "argName": "SecretArn", "argSource": "Ref" }
    }
  }
}
