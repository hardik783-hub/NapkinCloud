# ==========================================
# NapkinCloud Environment Configuration
# ==========================================

# AWS Bedrock Configuration
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token

# NapkinCloud Deployment Backend (Port 3001)
NAPKIN_BACKEND_URL=http://localhost:3001

# S3 Bucket for Lambda deployment artifacts
NAPKIN_S3_BUCKET=your-s3-bucket-name
