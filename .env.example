# ==========================================
# NapkinCloud Environment Configuration
# ==========================================

# 1. AWS Credentials for Amazon Bedrock (Claude 3.5 Sonnet)
# Required for AI Architecture Synthesis & Reasoning
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
# Optional: Only if using AWS Academy, SSO, or temporary STS credentials
# AWS_SESSION_TOKEN=your_aws_session_token

# 2. NapkinCloud Deployment Backend (Port 3001)
NAPKIN_BACKEND_URL=http://localhost:3001
